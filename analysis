Total Transactions =
COUNTROWS('Transactions')

Fraudulent Transactions =
CALCULATE(
    COUNTROWS('Transactions'),
    'Transactions'[fraud_flag] = 1
)

Fraud Rate =
DIVIDE(
    [Fraudulent Transactions],
    [Total Transactions],
    0
)

Total Transaction Value =
SUM('Transactions'[transaction_amount])

Fraudulent Transaction Value =
CALCULATE(
    SUM('Transactions'[transaction_amount]),
    'Transactions'[fraud_flag] = 1
)

Fraud Value Exposure % =
DIVIDE(
    [Fraudulent Transaction Value],
    [Total Transaction Value],
    0
)
